{
  "name": "morbin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:indexes": "node --experimental-strip-types scripts/ensure-indexes.ts",
    "db:migrate": "node --experimental-strip-types scripts/migrate-roles.ts",
    "admin:bootstrap": "node --experimental-strip-types scripts/bootstrap-admin.ts",
    "check:bootstrap": "node --experimental-strip-types lib/admin-bootstrap.check.mts",
    "check:delete-plan": "node --experimental-strip-types lib/admin-delete-plan.check.mts",
    "check:force-delete": "node scripts/check-force-delete.mjs",
    "test:flow": "node --experimental-strip-types scripts/test-flow.ts",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts",
    "check:pricing": "node --experimental-strip-types lib/pricing.check.mts",
    "check:money": "tsx --tsconfig scripts/tsconfig.checks.json --env-file=.env.local scripts/check-money.mts",
    "seed:dev-owner": "node --experimental-strip-types --env-file=.env.local scripts/seed-dev-owner.ts",
    "check:invoice": "tsx lib/invoice-rules.check.mts",
    "check:datasets": "node --experimental-strip-types lib/dataset-rules.check.mts",
    "check:templates": "node --experimental-strip-types lib/template-rules.check.mts",
    "check:flow": "node --experimental-strip-types lib/flow-diff.check.mts",
    "check:lookups": "tsx --tsconfig scripts/tsconfig.checks.json --env-file=.env.local scripts/check-lookups.mts",
    "check:privacy": "tsx --tsconfig scripts/tsconfig.checks.json --env-file=.env.local scripts/check-privacy.mts"
  },
  "dependencies": {
    "@auth/mongodb-adapter": "^3.11.3",
    "@aws-sdk/client-sesv2": "^3.1135.0",
    "@base-ui/react": "^1.8.0",
    "@tanstack/react-table": "^8.21.3",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.47.0",
    "mongodb": "^6.21.0",
    "next": "16.3.5",
    "next-auth": "^5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "ogl": "^1.0.11",
    "pdf-lib": "^1.17.1",
    "qr-scanner": "^1.4.2",
    "qrcode": "^1.5.4",
    "razorpay": "^2.9.8",
    "react": "19.2.8",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.2.8",
    "recharts": "^3.8.0",
    "shadcn": "^4.21.1",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.6",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "wrangler": "^4.134.0"
  },
  "allowScripts": {
    "esbuild@0.25.4": true,
    "esbuild@0.28.1": true,
    "workerd@1.20260917.1": true,
    "unrs-resolver@1.12.2": true
  }
}

{
	email {$ACME_EMAIL}
	servers {
		# Direct mode: nothing sits in front of Caddy, so only loopback is
		# trusted. Tunnel mode widens this to the Docker bridge, where the
		# host's cloudflared connects from (see docker-compose.tunnel.yml).
		trusted_proxies static {$TRUSTED_PROXIES:127.0.0.1/32}
	}
}

# Direct mode: the bare domain, so Caddy obtains a Let's Encrypt certificate.
# Tunnel mode: "http://<domain>", because TLS terminates at Cloudflare.
{$MORBIN_SITE_ADDRESS} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		-Server
	}

	# Body limit: largest legitimate upload is a 5 MB event banner.
	request_body {
		max_size 6MB
	}

	reverse_proxy app:3000 {
		health_uri /api/health
		health_interval 30s
	}

	log {
		output stdout
		# Never log query strings: magic-link tokens travel in them.
		format filter {
			wrap json
			fields {
				request>uri query {
					delete
				}
				request>headers>Cookie delete
				request>headers>Authorization delete
			}
		}
	}
}

# Morbin — production environment. Copy to `.env` on the server and fill in.
# Generate secrets with:  openssl rand -base64 48

# ── Host ────────────────────────────────────────────────────────────────────
MORBIN_DOMAIN=tickets.example.com
ACME_EMAIL=ops@example.com

# ── Database (internal to the Docker network; never published) ─────────────
MORBIN_DB=morbin
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=
MONGO_APP_USER=morbin_app
MONGO_APP_PASSWORD=

# ── Auth ────────────────────────────────────────────────────────────────────
AUTH_SECRET=
# Optional. Leave blank to keep Google sign-in OFF (no data shared with Google).
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Emails allowed to be promoted to platform admin, comma-separated.
ADMIN_EMAILS=
# Only used to create the very first admin account; remove after first login.
ADMIN_BOOTSTRAP_PASSWORD=

# ── Tickets ─────────────────────────────────────────────────────────────────
# HMAC key for QR signatures. Rotating it invalidates every issued QR code.
TICKET_SECRET=

# ── Payments (Razorpay, Morbin is merchant of record) ───────────────────────
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Email ───────────────────────────────────────────────────────────────────
EMAIL_FROM="Morbin <no-reply@example.com>"
# Amazon SES. Use an IAM user scoped to ses:SendEmail only.
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Manual job trigger (POST /api/cron/flush-emails). Jobs also run in-process.
CRON_SECRET=

# ── Local development only (compose builds MONGODB_URI itself) ──────────────
# MONGODB_URI=mongodb://localhost:27017/morbin?replicaSet=rs0
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# MORBIN_SCHEDULER=1

# ── Backups (encrypted, stored on this server) ──────────────────────────────
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
BACKUP_PASSPHRASE=

{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "morbin-dev",
  "compatibility_date": "2026-09-18",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./.open-next/worker.js",
  "assets": {
    "directory": "./.open-next/assets",
    "binding": "ASSETS"
  },
  // Dev is served on both hostnames: dev.morbin.space is the canonical dev
  // domain, test.morbin.space is kept for existing links.
  "routes": [
    { "pattern": "dev.morbin.space", "zone_name": "morbin.space", "custom_domain": true },
    { "pattern": "test.morbin.space", "zone_name": "morbin.space", "custom_domain": true }
  ],
  "vars": {
    "MORBIN_DB": "test_morbin_db"
  }
}

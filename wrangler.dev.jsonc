{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "morbin-dev",
  "compatibility_date": "2026-09-18",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./.open-next/worker.js",
  "assets": {
    "directory": "./.open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "MORBIN_DB": "test_morbin_db"
  }
}
